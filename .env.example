# PostgreSQL connection URL (matches docker-compose.yml)
POSTGRES_URL="postgres://postgres:postgres@localhost:5432/yoyaku_db"

# Auth session secret (at least 32 characters)
AUTH_SECRET="your-super-secret-auth-key-at-least-32-chars-long"

# Base URL
BASE_URL="http://localhost:3000"

# Default restaurant slug
DEFAULT_RESTAURANT_SLUG="kyoto-shabu"
NEXT_PUBLIC_DEFAULT_RESTAURANT_SLUG="kyoto-shabu"

# Initial admin credentials (optional, used by db:init / db:seed)
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="12345678"
INITIAL_ADMIN_NAME="田中"

# Email notification configuration (default: console simulation)
EMAIL_PROVIDER="console"
EMAIL_FROM="京都しゃぶしゃぶ <noreply@yoyaku-kit.example.com>"
EMAIL_API_KEY="your-email-api-key"

# Demo mode & cron reset
DEMO_MODE="false"
CRON_SECRET="your-vercel-cron-secret"

